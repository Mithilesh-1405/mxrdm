{
  "version": 2,
  "buildCommand": "cd frontend && npm ci && npm run build",
  "outputDirectory": "frontend/dist",
  "env": {
    "PYTHONUNBUFFERED": "1"
  },
  "services": [
    {
      "name": "frontend",
      "buildCommand": "cd frontend && npm ci && npm run build",
      "outputDirectory": "frontend/dist",
      "routes": [
        {
          "src": "/(?!api/).*",
          "dest": "/index.html"
        }
      ]
    },
    {
      "name": "backend",
      "runtime": "python3.11",
      "buildCommand": "cd backend && pip install -r requirements.txt",
      "routes": [
        {
          "src": "/api/(.*)",
          "dest": "/api/index.py"
        }
      ],
      "env": {
        "PYTHONUNBUFFERED": "1",
        "STATIC_DIR": ""
      }
    }
  ]
}